# === Application ===
APP_NAME=inventory-service
ENVIRONMENT=development   # development | production

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8086
GRPC_PORT=9086

# === Logging ===
# Semua log selalu JSON (satu record per baris), siap untuk log aggregation.
LOG_LEVEL=info            # debug | info | warn | error
# Optional: when set, every log line is also appended to this file (JSON)
#LOG_FILE=logs/app.log

# === Feature Flags ===
# Turn optional integrations on/off. When disabled, the dependency is never
# initialized and the app runs without it. Status is reported in /health and
# at startup.
REDIS_ENABLED=true
RABBITMQ_ENABLED=true
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LIFETIME_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=30
IDEMPOTENCY_HEADER=Idempotency-Key

# --- Realtime (WebSocket + SSE) & Distributed Bridge ---
# Master switch. Disabled for backend microservices that do not serve WebSocket / SSE.
REALTIME_ENABLED=false
REALTIME_SSE_ENABLED=false
REALTIME_WS_ENABLED=false
REALTIME_BRIDGE=local

# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coffe_inventory
DB_SSLMODE=disable
# Raw override URL if preferred:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coffe_inventory?sslmode=disable

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Raw override URL if preferred:
#REDIS_URL=redis://localhost:6379/0

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Raw override URL if preferred:
#RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# === JWT ===
# IMPORTANT: Change these secrets in production!
# Use at least 32 characters for better security
JWT_ACCESS_SECRET=change-this-to-a-random-secret-key-min-32-characters
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-min-32-chars
JWT_ACCESS_DURATION=15        # Access token duration in minutes
JWT_REFRESH_DURATION=168      # Refresh token duration in hours (7 days)
JWT_ROTATION_THRESHOLD_DAYS=2 # Rotate refresh token if expiring within N days
JWT_ISSUER=template-rust
COOKIE_SECURE=false           # Set true in production (HTTPS only)

# === OpenTelemetry ===
OTEL_ENABLED=true
OTEL_SERVICE_NAME=inventory-service-coffe
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.observability.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
